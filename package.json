{
  "name": "egghead",
  "version": "0.1.2",
  "description": "Simple quiz app",
  "main": "index.js",
  "scripts": {
     "build": "flatpak run org.flatpak.Builder --force-clean --sandbox --user --install-deps-from=flathub --ccache --mirror-screenshots-url=https://dl.flathub.org/media/ --repo=repo builddir io.github.josephmawa.Egghead.json",
    "lint-manifest": "flatpak run --command=flatpak-builder-lint org.flatpak.Builder manifest io.github.josephmawa.Egghead.json",
    "lint-appstream": "flatpak run --command=flatpak-builder-lint org.flatpak.Builder appstream data/io.github.josephmawa.Egghead.metainfo.xml.in",
    "lint-builddir": "flatpak run --command=flatpak-builder-lint org.flatpak.Builder builddir builddir",
    "lint-repo": "flatpak run --command=flatpak-builder-lint org.flatpak.Builder repo repo",
    "lint": "npm run build && npm run lint-manifest && npm run lint-appstream && npm run lint-builddir && npm run lint-repo",
    "init-build-dir": "flatpak run --command=meson --filesystem=host org.gnome.Sdk/x86_64/50 setup --wipe build-dir .",
    "gen-pot": "flatpak run --command=meson --filesystem=host org.gnome.Sdk/x86_64/50 compile -C build-dir egghead-pot",
    "gen-translation-files": "flatpak run --command=meson --filesystem=host org.gnome.Sdk/x86_64/50 compile -C build-dir egghead-update-po",
    "rm-build-artifacts": "rm -rf .flatpak-builder builddir repo build-dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephmawa/Egghead.git"
  },
  "keywords": [
    "quiz",
    "recreation",
    "app",
    "desktop",
    "linux"
  ],
  "author": "Joseph Mawa",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/josephmawa/Egghead/issues"
  },
  "homepage": "https://github.com/josephmawa/Egghead#readme"
}
